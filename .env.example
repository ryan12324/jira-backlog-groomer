# Jira Cloud. Secrets are read from the environment and never from the TOML file.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=service-account@example.com
JIRA_API_TOKEN=replace-me

# Alternatively use a bearer token:
# JIRA_AUTH_MODE=bearer
# JIRA_BEARER_TOKEN=replace-me

OPENAI_API_KEY=replace-me
